# ==============================================================================
# FilmFlow Inventory — Environment Variables Configuration
# ==============================================================================

# --- Client Frontend (.env) ---
# Your Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anonymous/Publishable Key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# --- Supabase Edge Functions Secrets (Set via: supabase secrets set KEY=VALUE) ---
# Supabase Admin / Service Role Key (Used exclusively inside Edge Functions for Google Sheets sync)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Cloud Service Account for Google Sheets API v4
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Delivery (Resend) for Password Resets
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM="FilmFlow Inventory <noreply@yourdomain.com>"
# APP_URL=https://your-inventory-app.pages.dev
# APP_NAME="FilmFlow Inventory"

# (Optional) Default Google Sheet IDs per department if not configured via UI registry
# DEFAULT_ART_SHEET_ID=
# DEFAULT_WD_SHEET_ID=
# DEFAULT_EQUIPMENT_SHEET_ID=
